{
  "name": "schemastore-to-typescript",
  "version": "1.0.1",
  "description": "Fetch JSON schemas from the JSON Schema Store catalog and compile them to TypeScript typings",
  "keywords": [
    "cli",
    "json-schema",
    "schemastore",
    "typescript"
  ],
  "homepage": "https://github.com/langri-sha/schemastore-to-typescript#readme",
  "bugs": {
    "url": "https://github.com/langri-sha/schemastore-to-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/schemastore-to-typescript.git"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "schemastore-to-typescript": "src/cli.ts"
  },
  "scripts": {
    "change": "pnpm exec projen change",
    "default": "pnpm exec projen default",
    "prepare": "husky",
    "prepublishOnly": "rm -rf dist; tsc --project tsconfig.build.json",
    "renovate": "pnpm exec projen renovate",
    "test": "vitest"
  },
  "dependencies": {
    "commander": "15.0.0",
    "debug": "4.4.3",
    "env-paths": "4.0.0",
    "es-main": "1.4.0",
    "got": "16.0.0",
    "json-schema-to-typescript": "16.0.0",
    "keyv": "5.6.0",
    "keyv-file": "5.3.5"
  },
  "devDependencies": {
    "@langri-sha/eslint-config": "0.9.16",
    "@langri-sha/lint-staged": "0.9.7",
    "@langri-sha/prettier": "0.4.8",
    "@langri-sha/projen-project": "0.31.2",
    "@langri-sha/tsconfig": "1.0.1",
    "@langri-sha/vitest": "0.2.0",
    "@types/debug": "4.1.13",
    "@types/node": "24.19.0",
    "beachball": "2.66.0",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "projen": "0.86.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.7.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">= 24.16.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "schemastore-to-typescript": "dist/cli.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
